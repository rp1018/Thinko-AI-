# Copy to .env (local) or add these in Render -> Environment
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# Used only if the main model times out / returns 5xx. Leave empty to disable.
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-70b-instruct
# Optional: enables the "Web search" source
SERP_API_KEY=
